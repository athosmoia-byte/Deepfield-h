    local aimAcc = 0
    RunService.RenderStepped:Connect(function()
        aimButton.Visible = aimbotOn

        if not running or not aimbotOn then return end
        if not isWeaponEquipped() then return end

        -- Mobile: só ativa enquanto segura o botão AIM
        if IS_MOBILE and not isAiming then return end
        -- PC: precisa estar atirando
        if not IS_MOBILE and not isShooting then return end

        aimAcc = aimAcc + (1 / 60)
        if aimAcc < 0.016 then return end
        aimAcc = 0

        if not camera then camera = Workspace.CurrentCamera end
        if not camera then return end

        updateFOVCircle()

        local targetHRP = pickAimbotTarget()
        if not targetHRP then return end

        -- Wall Check (Raycast moderno)
        if aimbotWallCheck then
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { lp.Character, camera }
            local ray = Workspace:Raycast(camera.CFrame.Position,
                (targetHRP.Position - camera.CFrame.Position), params)
            if ray and not ray.Instance:IsDescendantOf(targetHRP.Parent) then return end
        end

        -- Pega posição com predição
        local targetHead = targetHRP.Parent and targetHRP.Parent:FindFirstChild("Head")
        local aimPos = targetHead and targetHead.Position or targetHRP.Position
        if aimbotPrediction > 0 then
            local part = targetHRP.Parent:FindFirstChild(aimbotTargetPart) or targetHRP
            aimPos = predictPosition(part)
        end

        -- 1. Move a câmera com smoothness
        local goal = CFrame.new(camera.CFrame.Position, aimPos)
        if aimbotSmooth >= 0.99 then
            camera.CFrame = goal
        else
            camera.CFrame = camera.CFrame:Lerp(goal, aimbotSmooth)
        end

        -- 2. Mobile: simula toque virtual na tela
        local screenPos, onScreen = camera:WorldToViewportPoint(aimPos)
        if onScreen and IS_MOBILE then
            pcall(function()
                VIM:SendTouchEvent(1, Enum.UserInputState.Begin, screenPos.X, screenPos.Y, {})
                task.wait(0.03)
                VIM:SendTouchEvent(1, Enum.UserInputState.End, screenPos.X, screenPos.Y, {})
            end)
        end

        -- 3. Ativa a arma (fallback)
        local tool = getEquippedTool()
        if tool then
            local now = os.clock()
            if now - (getgenv()._dfLastAct or 0) > 0.15 then
                getgenv()._dfLastAct = now
                pcall(function() tool:Activate() end)
            end
        end
    end)

