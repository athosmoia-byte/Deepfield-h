                    local currentGuns = {}
                    for _, obj in ipairs(Workspace:GetChildren()) do
                        if isDroppedGun(obj) then currentGuns[obj] = true end
                    end
                    for _, folderName in ipairs({"GunDrop", "DroppedGuns", "Guns", "Weapons", "Drops"}) do
                        local folder = Workspace:FindFirstChild(folderName)
                        if folder then
                            for _, obj in ipairs(folder:GetChildren()) do
                                if isDroppedGun(obj) then currentGuns[obj] = true end
                            end
                        end
                    end
                    for tool in pairs(gunEspObjs) do
                        if not currentGuns[tool] or not tool.Parent then
                            clearGunESP(tool)
                        end
                    end
                    for tool in pairs(currentGuns) do
