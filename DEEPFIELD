    end

    local function isDroppedGun(obj)
        if not obj:IsA("Tool") then return false end
        if not obj:IsDescendantOf(Workspace) then return false end
        local parent = obj.Parent
        if parent and parent:IsA("Model") then
            if parent:FindFirstChildOfClass("Humanoid") then return false end
        end
        local n = string.lower(obj.Name)
        return n:find("gun") or n:find("pistol") or n:find("revolver")
    end

    task.spawn(function()
