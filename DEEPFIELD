            if not espGunOn then
                clearAllGunESP()
                task.wait(0.5)
            else
                safeCall("GunESP", function()
                    local currentGuns = {}
                    for _, obj in ipairs(Workspace:GetChildren()) do
                        if isDroppedGun(obj) then currentGuns[obj] = true end
                    end
                    for _, folderName in ipairs({"GunDrop", "DroppedGuns", "Guns", "Weapons", "Drops"}) do
                        local folder = Workspace:FindFirstChild(folderName)
                        if folder then
                            for _, obj in ipairs(folder:GetChildren()) do
                                if isDroppedGun(obj) then currentGuns[obj] = true end
                            end
                        end
                    end
                    for tool in pairs(gunEspObjs) do
                        if not currentGuns[tool] or not tool.Parent then
                            clearGunESP(tool)
                        end
                    end
                    for tool in pairs(currentGuns) do
                        if not gunEspObjs[tool] then
                            local handle = tool:FindFirstChild("Handle")
                            if handle and handle:IsA("BasePart") then
                                local hl = Instance.new("Highlight")
                                hl.Adornee = handle
                                hl.FillColor = Color3.fromRGB(255, 255, 0)
                                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                hl.FillTransparency = 0.5
                                hl.OutlineTransparency = 0.3
                                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                hl.Parent = handle

                                local bb = Instance.new("BillboardGui")
                                bb.Adornee = handle
                                bb.AlwaysOnTop = true
                                bb.Size = UDim2.fromOffset(120, 30)
                                bb.StudsOffset = Vector3.new(0, 2, 0)
                                bb.Parent = handle

                                local label = Instance.new("TextLabel")
                                label.Size = UDim2.fromScale(1, 1)
                                label.BackgroundTransparency = 1
                                label.Text = "GUN DROP"
                                label.TextColor3 = Color3.fromRGB(255, 255, 0)
