    btn.Position = UDim2.new(0, 20, 0, 128)
    btn.BackgroundColor3 = Color3.fromRGB(70, 130, 255)
    btn.Text = "Verificar"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 15
    local c3 = Instance.new("UICorner")
    c3.CornerRadius = UDim.new(0, 8)
    c3.Parent = btn

    local status = Instance.new("TextLabel", frame)
    status.Size = UDim2.new(1, -20, 0, 18)
    status.Position = UDim2.new(0, 10, 1, -22)
    status.BackgroundTransparency = 1
    status.Text = ""
    status.TextColor3 = Color3.fromRGB(255, 80, 80)
    status.Font = Enum.Font.Gotham
    status.TextSize = 12

    local validated = false

    btn.Activated:Connect(function()
        local input = box.Text
        if string.upper(input) == VALID_KEY then
            validated = true
            status.Text = "Key valida! Carregando..."
            status.TextColor3 = Color3.fromRGB(80, 220, 120)
            pcall(function()
                if writefile then writefile("deepfield_key.txt", input) end
