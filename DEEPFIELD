    local gunEspObjs = {}

    local function clearGunESP(tool)
        local obj = gunEspObjs[tool]
        if obj then
            pcall(function()
                if obj.highlight then obj.highlight:Destroy() end
                if obj.billboard then obj.billboard:Destroy() end
