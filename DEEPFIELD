            myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(aimPos.X, myRoot.Position.Y, aimPos.Z))
            if camera then
                camera.CFrame = CFrame.lookAt(camera.CFrame.Position, aimPos)
            end
        end

        local fired = false
        for _, child in ipairs(tool:GetDescendants()) do
            if child:IsA("RemoteEvent") then
                local ok, err = pcall(function() child:FireServer(hum) end)
                if ok then fired = true else log("WARN", "FireServer falhou: " .. tostring(err)) end
            end
        end
        return fired
    end

    local function bestTarget(maxDist)
        local myRoot = getHRP()
        if not myRoot then return nil end
        local best, bestDist = nil, maxDist or math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local d = (hrp.Position - myRoot.Position).Magnitude
                    if d < bestDist then best, bestDist = hrp, d end
                end
            end
        end
        return best
    end

    -- Predição de movimento do alvo
    local function predictPosition(part)
        if aimbotPrediction <= 0 then return part.Position end
        local vel = part.AssemblyLinearVelocity or part.Velocity
        return part.Position + (vel * aimbotPrediction)
    end

    -- Seleção de alvo (mais próximo da mira dentro do FOV)
    local function pickAimbotTarget()
        local myRole = guessRole(lp)
        local priorities = AIMBOT_PRIORITY[myRole]
        if not priorities then return nil end

        if not camera then camera = Workspace.CurrentCamera end
        if not camera then return nil end

        local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local best, bestScore = nil, math.huge

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp then
                local role = guessRole(p)
                local isPriority = false
                for _, wanted in ipairs(priorities) do
                    if role == wanted then isPriority = true; break end
                end
                if isPriority then
                    local hrp = aliveHRP(p)
                    if hrp then
                        local part = hrp.Parent:FindFirstChild(aimbotTargetPart) or hrp
                        local predPos = predictPosition(part)
                        local screenPos, onScreen = camera:WorldToViewportPoint(predPos)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                            if dist <= aimbotFOV and dist < bestScore then
                                bestScore = dist
                                best = hrp
                            end
                        end
                    end
                end
            end
        end
        return best
    end

    local function findMurderer()
        local myRoot = getHRP()
        local best, bestDist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp and guessRole(p) == "Murderer" and p.Character then
                local h = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if h and hum and hum.Health > 0 and myRoot then
                    local d = (h.Position - myRoot.Position).Magnitude
                    if d < bestDist then best = h; bestDist = d end
                end
            end
        end
        return best
    end

