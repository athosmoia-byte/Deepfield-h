    local function getEquippedTool()
        local c = getChar()
        return c and c:FindFirstChildOfClass("Tool")
    end

    local function isWeaponEquipped()
        local t = getEquippedTool()
        if not t then return false end
        local n = string.lower(t.Name):gsub("%s+", "")
        return n:find("gun") or n:find("pistol") or n:find("revolver")
            or n:find("knife") or n:find("faca")
    end

    local function aliveHRP(p)
        local c = p.Character
        if not c then return nil end
        local h = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChildOfClass("Humanoid")
        if h and hum and hum.Health > 0 then return h end
        return nil
    end

    local function findTool(keyword)
        local containers = {
            getChar(),
            lp:FindFirstChildOfClass("Backpack"),
            lp:FindFirstChild("StarterGear"),
        }
        for _, c in ipairs(containers) do
            if c then
                for _, t in ipairs(c:GetChildren()) do
                    if t:IsA("Tool") and string.find(string.lower(t.Name), keyword) then
                        return t
                    end
                end
            end
        end
        return nil
    end

    local function fireToolAt(tool, targetHRP)
        if not (tool and targetHRP) then return false end
        local targetChar = targetHRP.Parent
        local hum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
        if not hum then return false end

        local myRoot = getHRP()
        if myRoot then
            local targetHead = targetChar:FindFirstChild("Head")
            local aimPos = targetHead and targetHead.Position or targetHRP.Position
            myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(aimPos.X, myRoot.Position.Y, aimPos.Z))
            if camera then
                camera.CFrame = CFrame.lookAt(camera.CFrame.Position, aimPos)
            end
        end

        local fired = false
        for _, child in ipairs(tool:GetDescendants()) do
            if child:IsA("RemoteEvent") then
                local ok, err = pcall(function() child:FireServer(hum) end)
                if ok then fired = true else log("WARN", "FireServer falhou: " .. tostring(err)) end
            end
        end
        return fired
    end

    local function bestTarget(maxDist)
        local myRoot = getHRP()
        if not myRoot then return nil end
        local best, bestDist = nil, maxDist or math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local d = (hrp.Position - myRoot.Position).Magnitude
                    if d < bestDist then best, bestDist = hrp, d end
                end
            end
        end
        return best
    end

    -- 🔥 Innocent/Unknown retornam nil
    local function pickAimbotTarget()
        local myRole = guessRole(lp)
        local priorities = AIMBOT_PRIORITY[myRole]
        if not priorities then return nil end

        local myRoot = getHRP()
        for _, wanted in ipairs(priorities) do
            local best, bestD = nil, math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp and guessRole(p) == wanted then
                    local h = aliveHRP(p)
                    if h then
                        local d = myRoot and (h.Position - myRoot.Position).Magnitude or 0
                        if d < bestD then best, bestD = h, d end
                    end
                end
            end
            if best then return best end
        end
        return nil
    end

    local function findMurderer()
        local myRoot = getHRP()
        local best, bestDist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp and guessRole(p) == "Murderer" and p.Character then
                local h = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if h and hum and hum.Health > 0 and myRoot then
                    local d = (h.Position - myRoot.Position).Magnitude
                    if d < bestDist then best = h; bestDist = d end
                end
            end
        end
        return best
    end

