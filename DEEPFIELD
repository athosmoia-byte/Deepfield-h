    local function roleFromTool(player)
        local function scan(container)
            if not container then return nil end
            for _, t in ipairs(container:GetChildren()) do
                if t:IsA("Tool") then
                    local n = string.lower(t.Name):gsub("%s+", "")
                    if n:find("knife") or n:find("faca") then return "Murderer" end
                    if n:find("gun") or n:find("pistol") or n:find("revolver") then return "Sheriff" end
                end
            end
            return nil
        end
        return scan(player.Character) or scan(player:FindFirstChildOfClass("Backpack"))
    end

    local function guessRoleRaw(player)
        local ok, result = pcall(function()
            local team = player.Team
            if team then
                local tn = team.Name
                if ROLE_COLORS[tn] then return tn end
                local ltn = string.lower(tn)
                if ltn:find("murder") then return "Murderer" end
                if ltn:find("sheriff") then return "Sheriff" end
                if ltn:find("innocent") then return "Innocent" end
            end
            local attr = player:GetAttribute("Role")
            if attr and ROLE_COLORS[attr] then return attr end
            for _, child in ipairs(player:GetChildren()) do
                if child:IsA("StringValue") and ROLE_COLORS[child.Value] then return child.Value end
            end
            return roleFromTool(player) or "Unknown"
        end)
        if not ok then
            log("WARN", "guessRoleRaw falhou para " .. player.Name .. ": " .. tostring(result))
            return "Unknown"
        end
        return result
    end

    local function guessRole(player)
        local now = os.clock()
        if now - roleCacheTime > 0.5 then
            roleCache = {}
            roleCacheTime = now
        end
        if roleCache[player] then return roleCache[player] end
        local r = guessRoleRaw(player)
        roleCache[player] = r
        return r
    end

