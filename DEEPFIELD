    -- ============================================================
    -- BOX ESP + TRACER
    -- ============================================================
    local function updateBoxESP(hrp, color)
        local obj = boxESPs[hrp]
        if not obj then
            obj = {}
            obj.top    = Drawing.new("Line")
            obj.bottom = Drawing.new("Line")
            obj.left   = Drawing.new("Line")
            obj.right  = Drawing.new("Line")
            for _, l in pairs(obj) do
                l.Thickness = 1.5
                l.Transparency = 0.85
            end
            boxESPs[hrp] = obj
        end

        local head = hrp.Parent and hrp.Parent:FindFirstChild("Head")
        if not head or not camera then
            for _, l in pairs(obj) do l.Visible = false end
            return
        end

        local topPos, topVis = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local botPos, botVis = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
        if not (topVis and botVis) then
            for _, l in pairs(obj) do l.Visible = false end
            return
        end

        local height = math.abs(botPos.Y - topPos.Y)
        local width = height * 0.55
        local x1, x2 = topPos.X - width / 2, topPos.X + width / 2
        local y1, y2 = topPos.Y, botPos.Y

        obj.top.From    = Vector2.new(x1, y1); obj.top.To    = Vector2.new(x2, y1)
        obj.bottom.From = Vector2.new(x1, y2); obj.bottom.To = Vector2.new(x2, y2)
        obj.left.From   = Vector2.new(x1, y1); obj.left.To   = Vector2.new(x1, y2)
        obj.right.From  = Vector2.new(x2, y1); obj.right.To  = Vector2.new(x2, y2)

        for _, l in pairs(obj) do
            l.Color = color
            l.Visible = true
        end
    end

    local function updateTracer(hrp, color)
        local line = tracerLines[hrp]
        if not line then
            line = Drawing.new("Line")
            line.Thickness = 1
            line.Transparency = 0.7
            tracerLines[hrp] = line
        end
        if not camera then line.Visible = false; return end
        local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then line.Visible = false; return end
        line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
        line.To = Vector2.new(screenPos.X, screenPos.Y)
        line.Color = color
        line.Visible = true
    end

